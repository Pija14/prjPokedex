# Copie para .env e ajuste. O arquivo .env NUNCA vai para o git.

# development (uso local) ou production (servidor publicado: exige senha e SECRET_KEY)
APP_ENV=development

# Chave do Google Gemini — reconhecimento da carta pela foto (https://aistudio.google.com/apikey).
# Fica só no servidor; nunca é enviada ao navegador.
GEMINI_API_KEY=
# Opcional: modelo principal e reservas (cada modelo tem a própria cota diária no plano gratuito)
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-flash-latest

# Servidor local (0.0.0.0 permite acessar pelo celular na mesma rede Wi-Fi)
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=1

# Login do dono da coleção: gerados por  python scripts/set_password.py  (grava só o hash da senha)
# Sem eles, o CardDex local fica aberto, sem login. Em produção são obrigatórios.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_DAYS=30

# Assina o cookie de login. O set_password.py gera um aleatório; em produção é obrigatório (32+ caracteres).
SECRET_KEY=troque-por-um-texto-aleatorio
